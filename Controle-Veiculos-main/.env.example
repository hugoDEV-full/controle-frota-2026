# ===== Banco de dados principal (obrigatório) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha_do_mysql
DB_NAME=controle_frota

# Alternativa (Railway/produção): URL completa — se definida, tem prioridade
# MYSQL_URL=mysql://usuario:senha@host:3306/banco

# ===== Aplicação =====
PORT=3000
NODE_ENV=development
# Gere uma chave forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_SESSION=troque_por_uma_chave_secreta_forte

# ===== HTTPS (opcional em dev; recomendado em produção) =====
HTTPS_ENABLED=false
SSL_KEY_PATH=/certs/privkey.pem
SSL_CERT_PATH=/certs/fullchain.pem

# ===== E-mail (recuperação de senha e notificações) =====
# Para Gmail, use uma "senha de app": https://myaccount.google.com/apppasswords
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=senha_de_app_do_email
NOTIFY_EMAIL=email_que_recebe_alertas@empresa.com

# ===== GPS (opcional) =====
# Se vazio, usa o banco principal (DB_*) para as tabelas de GPS
GPS_DB_HOST=
GPS_DB_USER=
GPS_DB_PASSWORD=
GPS_DB_NAME=
GPS_DB_PORT=
