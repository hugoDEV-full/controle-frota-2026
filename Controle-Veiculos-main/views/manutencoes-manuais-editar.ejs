<%
// manutencoes-manuais-editar.ejs
// Variáveis esperadas: manu (obj da tabela manutencoes_manuais + veiculo_nome, placa), arquivos (array), csrfToken, user
const manuSafe = typeof manu !== 'undefined' && manu ? manu : {};
const arquivosList = typeof arquivos !== 'undefined' ? arquivos : [];
const csrfTokenSafe = typeof csrfToken !== 'undefined' ? csrfToken : '';

function fmtDate(d) {
  if (!d) return '-';
  const s = (d instanceof Date) ? d.toISOString() : String(d);
  const m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (!m) return s;
  return `${m[3]}/${m[2]}/${m[1]}`;
}

function fmtDateTime(d) {
  if (!d) return '-';
  const s = (d instanceof Date) ? d.toISOString().replace('T', ' ') : String(d);
  const m = s.match(/^(\d{4})-(\d{2})-(\d{2})\s+(\d{2}:\d{2})/);
  if (!m) return fmtDate(s);
  return `${m[3]}/${m[2]}/${m[1]} ${m[4]}`;
}

function fmtSize(bytes) {
  const n = Number(bytes) || 0;
  if (n < 1024) return n + ' B';
  if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
  return (n / (1024 * 1024)).toFixed(1) + ' MB';
}

function statusBadge(st) {
  if (st === 'pendente') return '<span class="badge bg-warning text-dark">Pendente</span>';
  if (st === 'em_manutencao') return '<span class="badge bg-info text-dark">Em manutenção</span>';
  if (st === 'realizada') return '<span class="badge bg-success">Realizada</span>';
  return '<span class="badge bg-secondary">' + (st || '-') + '</span>';
}
%>

<div class="container-fluid my-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Manutenção #<%= manuSafe.id %></h3>
        <a href="/manutencoes-manuais" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-left"></i> Voltar
        </a>
      </div>

      <!-- Dados da manutenção -->
      <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Dados da manutenção</h5>
          <%- statusBadge(manuSafe.status) %>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <div class="small text-muted">Veículo</div>
              <div class="fw-bold"><%= manuSafe.veiculo_nome || '-' %> <%= manuSafe.placa ? '(' + manuSafe.placa + ')' : '' %></div>
            </div>
            <div class="col-12 col-md-6">
              <div class="small text-muted">Tipo</div>
              <div class="fw-bold"><%= manuSafe.tipo || '-' %></div>
            </div>
            <div class="col-12">
              <div class="small text-muted">Descrição</div>
              <div style="white-space:pre-wrap; word-break:break-word;"><%= manuSafe.descricao || '-' %></div>
            </div>
            <div class="col-6 col-md-3">
              <div class="small text-muted">KM agendado</div>
              <div><%= manuSafe.km_agendado || '-' %></div>
            </div>
            <div class="col-6 col-md-3">
              <div class="small text-muted">Data agendada</div>
              <div><%= fmtDate(manuSafe.data_agendada) %></div>
            </div>
            <div class="col-6 col-md-3">
              <div class="small text-muted">Criado em</div>
              <div><%= fmtDateTime(manuSafe.criado_em) %></div>
            </div>
            <div class="col-6 col-md-3">
              <div class="small text-muted">Criado por</div>
              <div><%= manuSafe.criado_por || '-' %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Marcar como realizada -->
      <% if (manuSafe.status !== 'realizada') { %>
        <div class="card shadow-sm mb-3">
          <div class="card-body">
            <h6 class="mb-2">Concluir manutenção</h6>
            <form action="/manutencoes-manuais/<%= manuSafe.id %>/marcar-realizada" method="post"
                  class="row g-2 align-items-end"
                  onsubmit="return confirm('Marcar esta manutenção como realizada?')">
              <input type="hidden" name="_csrf" value="<%= csrfTokenSafe %>">
              <div class="col-12 col-md-4">
                <label for="km_realizado" class="form-label small mb-1">KM realizado (opcional)</label>
                <input type="number" id="km_realizado" name="km_realizado" class="form-control form-control-sm" min="0">
                <div class="form-text">Se informado, atualiza o KM do veículo.</div>
              </div>
              <div class="col-12 col-md-auto">
                <button type="submit" class="btn btn-sm btn-success">
                  <i class="bi bi-check2-circle"></i> Marcar como realizada
                </button>
              </div>
            </form>
          </div>
        </div>
      <% } %>

      <!-- Upload de arquivos -->
      <div class="card shadow-sm mb-3">
        <div class="card-header">
          <h5 class="mb-0">Anexos</h5>
        </div>
        <div class="card-body">
          <form action="/manutencoes-manuais/<%= manuSafe.id %>/upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="_csrf" value="<%= csrfTokenSafe %>">
            <div class="col-12 col-md-5">
              <label for="arquivos" class="form-label small mb-1">Arquivos (fotos / PDFs)</label>
              <input type="file" id="arquivos" name="arquivos" multiple accept="image/*,application/pdf" class="form-control form-control-sm" required>
            </div>
            <div class="col-12 col-md-4">
              <label for="tipo" class="form-label small mb-1">Tipo do anexo</label>
              <select id="tipo" name="tipo" class="form-select form-select-sm">
                <option value="">Automático</option>
                <option value="foto">Foto</option>
                <option value="documento">Documento</option>
              </select>
            </div>
            <div class="col-12 col-md-3 d-grid">
              <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-upload"></i> Enviar
              </button>
            </div>
          </form>

          <% if (arquivosList.length === 0) { %>
            <div class="alert alert-info mb-0">Nenhum anexo enviado.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover table-sm align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Arquivo</th>
                    <th>Tipo</th>
                    <th class="text-nowrap">Tamanho</th>
                    <th class="text-nowrap">Enviado em</th>
                    <th class="text-end">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% arquivosList.forEach(a => { %>
                    <tr>
                      <td style="max-width:280px; white-space:normal; word-break:break-word;">
                        <a href="/manutencoes-manuais/<%= manuSafe.id %>/arquivo/<%= a.id %>" target="_blank">
                          <i class="bi bi-paperclip"></i> <%= a.original_name || a.filename %>
                        </a>
                      </td>
                      <td><span class="badge bg-secondary"><%= a.tipo || '-' %></span></td>
                      <td class="text-nowrap"><small><%= fmtSize(a.size) %></small></td>
                      <td class="text-nowrap"><small class="text-muted"><%= fmtDateTime(a.criado_em) %></small></td>
                      <td class="text-end">
                        <form action="/manutencoes-manuais/<%= manuSafe.id %>/arquivo/<%= a.id %>/delete" method="post" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfTokenSafe %>">
                          <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Excluir este anexo?')">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>
